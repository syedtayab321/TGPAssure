# TGPAssure authentication, subscription and payment configuration
# Copy this file to .env in the TGPAssure project folder or to ~/.tgpassure/.env.

# production | development
TGPA_ENV=development
TGPA_CURRENCY=PKR

# Firebase Web API key and project ID
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE=(default)

# Stripe Checkout must be created on your secure backend, not inside the desktop client.
# The backend should create a Stripe Checkout Session and return JSON: {"url":"https://checkout.stripe.com/...", "session_id":"..."}
TGPA_STRIPE_CHECKOUT_URL=
TGPA_STRIPE_CUSTOMER_PORTAL_URL=
TGPA_STRIPE_SUCCESS_URL=https://checkout.stripe.com/success
TGPA_STRIPE_CANCEL_URL=https://checkout.stripe.com/cancel

# Development shortcuts
TGPA_DEV_AUTO_LOGIN=true
TGPA_DEV_AUTO_APPROVE_PAYMENT=true
TGPA_DEV_NAME=TGP Development User
TGPA_DEV_EMAIL=developer@tgpassure.local
TGPA_DEV_PASSWORD=tgpassure-dev
